FROM fedora:40

RUN dnf -y update

RUN dnf -y install \
  pandoc \
  wget \
  git \
  nodejs \
  golang

WORKDIR /hugo
RUN wget https://github.com/gohugoio/hugo/releases/download/v0.152.0/hugo_extended_0.152.0_Linux-64bit.tar.gz && \
  tar -xvf hugo_extended_0.152.0_Linux-64bit.tar.gz && \
  install hugo /usr/bin
RUN npm install -D --save postcss-cli

WORKDIR /website

EXPOSE 1313
